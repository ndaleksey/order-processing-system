@startuml

package "Kafka Topics" {
	queue "orders" {
		[OrderCreated]
		[OrderConfirmed]
		[OrderCancelled]
	}

	queue "payment-events" {
		[PaymentSucceeded]
		[PaymentFailed]
	}

	queue "inventory-events" {
		[InventoryReserved]
		[InventoryFailed]
	}

	queue "notification-events" {
		[EmailSent]
	}
}

@enduml